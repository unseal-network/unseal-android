data: {"subtype": "response.output_chunk.delta", "item_id": "chunk_22", "index": 21, "type": "streaming", "content": "{\"type\":\"tool-input-available\",\"toolCallId\":\"call_01_5fKCgxyt6tIB2Pz2QE140303\",\"toolName\":\"skill\",\"input\":{\"name\":\"sandbox-environment\"}}"}

